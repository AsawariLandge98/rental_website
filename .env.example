DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production only — add your real custom domain(s) once you have one, e.g.
# "https://rentora.com,https://www.rentora.com". Render's own *.onrender.com
# subdomain is already trusted by default without setting this.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production only — comma-separated "Name:email" pairs. When set, unhandled
# server errors are emailed to these addresses (via the SMTP settings
# below). Optional but recommended before going live — without it, a 500
# error in production is only visible in the host's own log viewer.
DJANGO_ADMINS=
SERVER_EMAIL=

# Local dev connects to Postgres via the discrete DB_* vars below. On
# Render (or any host that hands you a single connection string instead),
# set DATABASE_URL and leave DB_* blank — it takes priority automatically.
DATABASE_URL=

DB_NAME=rental_website
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Razorpay test-mode keys (leave blank until you have a test account —
# see Documentation/Feature 12 - Subscription Plans and Payments.md)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google OAuth Client ID/Secret (leave blank until you create one in Google
# Cloud Console — Continue with Google stays hidden until both are set)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# S3-compatible cloud storage for uploaded files (property photos, profile
# photos, CMS logo/favicon). Leave blank to keep saving to local disk
# (media/) exactly as today. Works with real AWS S3, or any S3-compatible
# provider (DigitalOcean Spaces, Backblaze B2, Cloudflare R2) via
# AWS_S3_ENDPOINT_URL — leave that one blank for real AWS S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=

# Real SMTP email — leave blank to keep printing emails (password reset,
# etc.) to the console instead of sending them. For Gmail: EMAIL_HOST=
# smtp.gmail.com, EMAIL_PORT=587, EMAIL_HOST_USER=your@gmail.com,
# EMAIL_HOST_PASSWORD=<a 16-character App Password, NOT your Gmail
# password — generate one at myaccount.google.com/apppasswords, requires
# 2-Step Verification to be on>. Any other SMTP provider (SendGrid, AWS
# SES, Mailgun...) works the same way with their own host/port/credentials.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Rentora <no-reply@rentora.local>

# SMS gateway for Mobile OTP verification (Feature 24). Leave blank to keep
# the verify flow in dev mode — the generated code is shown on-screen
# instead of being texted, so it's fully testable with no SMS account.
# No specific provider is wired up yet (core/sms.py posts SMS_API_KEY/
# SMS_SENDER_ID/mobile/message to SMS_API_URL) — once you pick a gateway
# (MSG91, Fast2SMS, Twilio, ...), set these to its real send-SMS endpoint
# and credentials, adjusting core/sms.py's payload to match that
# provider's exact API if it differs from this generic shape.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=RENTRA
